# ---- R / RStudio ----
.Rproj.user/
.Rhistory
.RData
.Ruserdata
.Renviron
*.Rcheck/

# ---- logs (kept on each machine, not in git) ----
logs/

# ---- data: never in git. Data lives under data_root (config.yml), outside the repo. ----
# These patterns are a safety net in case anything lands inside the repo by mistake.
data/
raw/
outputs/
*.tif
*.tiff
*.tif.aux.xml
*.ovr
*.nc
*.nc4
*.bil
*.hdr
*.zip
*.gz
*.tar
*.rds
*.RDS
*.rda
*.parquet
*.feather
*.gpkg
*.shp
*.shx
*.dbf
*.prj
*.cpg
*.h5
*.hdf

# ---- OS ----
.DS_Store
Thumbs.db
desktop.ini

# ---- project page: rendered output (figures in report/figs/ ARE committed) ----
report/*.html
report/*_files/
report/.quarto/
data/npn_site_names.csv 

# ---- NPN study subfolder (npn_study/, self-contained; becomes its own repo at publication) ----
# Its two small data tables ARE committed; site names (people's yards) never are.
!npn_study/data/
npn_study/data/*
!npn_study/data/npn_species_pathway.csv
!npn_study/data/npn_site_ecoregions.csv
npn_study/logs/
npn_study/report/*.html
npn_study/report/*_files/
npn_study/report/.quarto/
